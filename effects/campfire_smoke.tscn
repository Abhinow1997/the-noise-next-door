[gd_scene load_steps=9 format=3]

; Effect B, the campfire smoke (CHANGE-BRIEF.md, "Revised 8 Nov 2026: Effect B, the campfire
; smoke", "The settings"). One GPUParticles3D, Smoke, under a Node3D root, placed at the fire
; pit. Every value here is the brief's; a change to one starts as a dated revision of
; CHANGE-BRIEF.md (CLAUDE.md, "Ownership"). Continuous: emitting on, with preprocess 3.5 s
; so a burning fire has its column on the first frame. The feedback (amount_ratio = the
; fire's strength, every frame) is set by presentation code, never here: amount_ratio is
; 1.0 in the scene and amount never changes. No fixed seed here: the preview sets one on
; its own instance only. Written by Claude Code, 8 Nov 2026.

; color_ramp: alpha 0 -> 0.25 at 15% of the life -> 0; colour warm grey #9b938a -> blue-grey
; #6f7a85 over the life (the 15% stop is that blend at 0.15, so the colour change is even).
[sub_resource type="Gradient" id="Gradient_smoke_ramp"]
offsets = PackedFloat32Array(0, 0.15, 1)
colors = PackedColorArray(0.607843, 0.576471, 0.541176, 0, 0.581961, 0.561765, 0.538235, 0.25, 0.435294, 0.478431, 0.521569, 0)

[sub_resource type="GradientTexture1D" id="GradientTexture1D_smoke_ramp"]
gradient = SubResource("Gradient_smoke_ramp")

; scale_curve: 0.4 -> 1.6 over the life, a straight line (tangents 1.2 both sides). The
; Curve's value range is widened to 0..2 so 1.6 isn't clamped to the default 0..1.
[sub_resource type="Curve" id="Curve_smoke_scale"]
max_value = 2.0
_data = [Vector2(0, 0.4), 0.0, 1.2, 0, 1, Vector2(1, 1.6), 1.2, 0.0, 1, 0]
point_count = 2

[sub_resource type="CurveTexture" id="CurveTexture_smoke_scale"]
curve = SubResource("Curve_smoke_scale")

[sub_resource type="ParticleProcessMaterial" id="ParticleProcessMaterial_smoke"]
lifetime_randomness = 0.2
emission_shape_offset = Vector3(0, 0.35, 0)
emission_shape = 3
emission_box_extents = Vector3(0.25, 0.05, 0.25)
angle_min = 0.0
angle_max = 360.0
direction = Vector3(0, 1, 0)
spread = 12.0
initial_velocity_min = 0.35
initial_velocity_max = 0.6
gravity = Vector3(0, 0.12, 0)
damping_min = 0.1
damping_max = 0.2
scale_min = 0.8
scale_max = 1.2
scale_curve = SubResource("CurveTexture_smoke_scale")
color_ramp = SubResource("GradientTexture1D_smoke_ramp")
turbulence_enabled = true
turbulence_noise_strength = 0.6
turbulence_noise_scale = 2.0

; The soft disc: white, opaque at the centre, clear at the edge (radial, centre to edge).
[sub_resource type="Gradient" id="Gradient_smoke_disc"]
offsets = PackedFloat32Array(0, 1)
colors = PackedColorArray(1, 1, 1, 1, 1, 1, 1, 0)

[sub_resource type="GradientTexture2D" id="GradientTexture2D_smoke_disc"]
gradient = SubResource("Gradient_smoke_disc")
width = 64
height = 64
fill = 1
fill_from = Vector2(0.5, 0.5)
fill_to = Vector2(1, 0.5)

[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_smoke"]
transparency = 1
blend_mode = 0
shading_mode = 0
vertex_color_use_as_albedo = true
albedo_texture = SubResource("GradientTexture2D_smoke_disc")
billboard_mode = 3

[sub_resource type="QuadMesh" id="QuadMesh_smoke"]
material = SubResource("StandardMaterial3D_smoke")
size = Vector2(0.5, 0.5)

[node name="CampfireSmoke" type="Node3D"]

; visibility_aabb: 3 x 4 x 3 m round the pit, from the ground up.
[node name="Smoke" type="GPUParticles3D" parent="."]
emitting = true
amount = 40
lifetime = 3.5
one_shot = false
preprocess = 3.5
explosiveness = 0.0
local_coords = false
visibility_aabb = AABB(-1.5, 0, -1.5, 3, 4, 3)
process_material = SubResource("ParticleProcessMaterial_smoke")
draw_pass_1 = SubResource("QuadMesh_smoke")
