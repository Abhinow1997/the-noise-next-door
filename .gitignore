# Godot's import cache and editor state
.godot/
/android/

# Blender backup / temp saves (.blend1, .blend2, ... from Save Versions)
*.blend[0-9]*
*.blend@

# Films and large media go to the course's media storage, not GitHub
*.mp4
*.mov
*.mkv
# Assignment 2's music and laugh originals: over 25 MB, or MP3s. They're kept on disk and in the course
# media storage, linked from the README; the game only loads the cut loops in assets/audio/.
*.mp3
design/music/*.wav

# Python
__pycache__/
*.pyc

# OS clutter
Thumbs.db
desktop.ini
.DS_Store
