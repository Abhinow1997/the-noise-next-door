[gd_resource type="Animation" format=3]

; The 3D balloon's pop (CHANGE-BRIEF.md, revision of 21 Nov 2026, "the balloons are 3D"; not
; graded): a quick swell of its Float node (body and string), scale 1 to 1.35 over 3 frames at
; 24 fps (0.125 s), step 1/24 s, LOOP_NONE. Played once by the balloon's own script when it's
; bitten, which then hides the balloon. The path is relative to the AnimationPlayer's root_node
; (the Balloon, in props/party_balloon.tscn).

[resource]
resource_name = "pop"
length = 0.125
step = 0.041666668
tracks/0/type = "value"
tracks/0/imported = false
tracks/0/enabled = true
tracks/0/path = NodePath("Float:scale")
tracks/0/interp = 1
tracks/0/loop_wrap = true
tracks/0/keys = {
"times": PackedFloat32Array(0, 0.125),
"transitions": PackedFloat32Array(1, 1),
"update": 0,
"values": [Vector3(1, 1, 1), Vector3(1.35, 1.35, 1.35)]
}
