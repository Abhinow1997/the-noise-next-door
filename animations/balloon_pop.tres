[gd_resource type="Animation" format=3]

; The balloon's pop (CHANGE-BRIEF.md, revision of 21 Nov 2026, "The extras' timings and places"):
; cells 3, 4, 5 (cracks, bursts, shreds) on the Sprite3D's frame, each held 2 frames at 24 fps,
; keys at frames 0, 2, 4 (0, 2/24, 4/24 s), length 6/24 s (0.25 s), step 1/24 s, discrete updates,
; LOOP_NONE: played once by the balloon's own script when it's bitten, which then hides it. The
; track's path is relative to the AnimationPlayer's root_node (the Balloon Sprite3D in
; props/party_balloon.tscn).

[resource]
resource_name = "pop"
length = 0.25
step = 0.041666668
tracks/0/type = "value"
tracks/0/imported = false
tracks/0/enabled = true
tracks/0/path = NodePath(".:frame")
tracks/0/interp = 0
tracks/0/loop_wrap = true
tracks/0/keys = {
"times": PackedFloat32Array(0, 0.083333336, 0.16666667),
"transitions": PackedFloat32Array(1, 1, 1),
"update": 1,
"values": [3, 4, 5]
}
