[gd_resource type="Animation" format=3]

; The balloon's float (CHANGE-BRIEF.md, "The cycle spec: the balloon's float"): cells 0, 1, 2, 1
; out and back on the Sprite3D's frame, keys at frames 0, 6, 12, 18 of 24 at 24 fps (0, 0.25,
; 0.5, 0.75 s), length 1.0 s, step 1/24 s, discrete updates, LOOP_LINEAR. No duplicate across the
; wrap: the last key is cell 1, the first cell 0, and the last gap (0.75 to 1.0 s) is the key
; interval, 0.25 s. The track's path is relative to the AnimationPlayer's root_node (the
; Balloon Sprite3D in props/party_balloon.tscn).

[resource]
resource_name = "float"
length = 1.0
loop_mode = 1
step = 0.041666668
tracks/0/type = "value"
tracks/0/imported = false
tracks/0/enabled = true
tracks/0/path = NodePath(".:frame")
tracks/0/interp = 0
tracks/0/loop_wrap = true
tracks/0/keys = {
"times": PackedFloat32Array(0, 0.25, 0.5, 0.75),
"transitions": PackedFloat32Array(1, 1, 1, 1),
"update": 1,
"values": [0, 1, 2, 1]
}
