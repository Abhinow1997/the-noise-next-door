[gd_resource type="Animation" format=3]

; The 3D balloon's bob (CHANGE-BRIEF.md, revision of 21 Nov 2026, "the balloons are 3D"; not
; graded): a gentle rise and fall, 4 cm, with a slight sway, on the balloon's Float node (its
; body and string; the balloon's own node, where the bite measures from, never moves). Length
; 2.0 s (48 frames at 24 fps), step 1/24 s, LOOP_LINEAR; cubic, wrapping round. Rise: keys at 0
; and 1.0 s; sway: 0, 0.5, 1.0 and 1.5 s. Each balloon starts it at its own offset (its script).
; The paths are relative to the AnimationPlayer's root_node (the Balloon, in
; props/party_balloon.tscn).

[resource]
resource_name = "bob"
length = 2.0
loop_mode = 1
step = 0.041666668
tracks/0/type = "value"
tracks/0/imported = false
tracks/0/enabled = true
tracks/0/path = NodePath("Float:position")
tracks/0/interp = 2
tracks/0/loop_wrap = true
tracks/0/keys = {
"times": PackedFloat32Array(0, 1),
"transitions": PackedFloat32Array(1, 1),
"update": 0,
"values": [Vector3(0, 0, 0), Vector3(0, 0.04, 0)]
}
tracks/1/type = "value"
tracks/1/imported = false
tracks/1/enabled = true
tracks/1/path = NodePath("Float:rotation")
tracks/1/interp = 2
tracks/1/loop_wrap = true
tracks/1/keys = {
"times": PackedFloat32Array(0, 0.5, 1, 1.5),
"transitions": PackedFloat32Array(1, 1, 1, 1),
"update": 0,
"values": [Vector3(0, 0, 0), Vector3(0, 0, 0.05), Vector3(0, 0, 0), Vector3(0, 0, -0.05)]
}
